# Copy to .env.local and fill in. Supabase dashboard -> Connect.
# Only the project URL and the publishable (anon) key. Never add a
# service_role or sb_secret_ key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix any of these with NEXT_PUBLIC_. Without a key, AI
# text falls back to templates. src/lib/llm.ts reads them. OpenRouter API key(s):
#
# One key for everything:
LLM_API_KEY=
# Optional: a separate key and/or model per use. Each falls back to LLM_API_KEY
# and the default model anthropic/claude-haiku-5.5.
# "What's missing" cards:
LLM_CARDS_API_KEY=
LLM_CARDS_MODEL=
# Planning assistant (chatbot):
LLM_CHAT_API_KEY=
LLM_CHAT_MODEL=
