# Copy to .env.local and fill in. Supabase dashboard -> Connect.
# Only the project URL and the publishable (anon) key. Never add a
# service_role or sb_secret_ key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix any of these with NEXT_PUBLIC_. Without a key, AI
# text falls back to templates. src/lib/llm.ts reads them.
#
# One key for everything (OpenRouter by default):
LLM_API_KEY=
# Or a separate provider per use. Each is optional and falls back to LLM_API_KEY
# and the default model. The endpoint must be OpenAI-compatible chat completions.
# "What's missing" cards:
LLM_CARDS_API_KEY=
LLM_CARDS_MODEL=
LLM_CARDS_ENDPOINT=
# Planning assistant (chatbot):
LLM_CHAT_API_KEY=
LLM_CHAT_MODEL=
LLM_CHAT_ENDPOINT=
