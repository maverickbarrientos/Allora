# Copy to .env.local and fill in. Supabase dashboard -> Connect.
# Only the project URL and the publishable (anon) key. Never add a
# service_role or sb_secret_ key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. OpenRouter API key for src/lib/llm.ts. Never prefix with
# NEXT_PUBLIC_. Without it, AI text falls back to templates.
LLM_API_KEY=
