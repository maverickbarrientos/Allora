# Copy to .env.local and fill in. Supabase dashboard -> Connect.
# Only the project URL and the publishable (anon) key. Never add a
# service_role or sb_secret_ key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Temporary: set to true to run the auth screens against src/mocks/auth.ts (no backend).
NEXT_PUBLIC_USE_MOCKS=false
